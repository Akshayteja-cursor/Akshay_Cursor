          "expression": "10",
          "isAvailableInMdx": false
        },
        {
          "name": "StyleNumber_BK",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "StyleNumber_BK",
          "isAvailableInMdx": false
        },
        {
          "name": "StorageLocation",
          "dataType": "string",
