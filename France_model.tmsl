        },
        {
          "name": "StockSegment",
          "dataType": "string",
          "sourceColumn": "StockSegment"
        },
        {
          "name": "CompanyCode",
          "dataType": "string",
          "isHidden": true,
          "sourceColumn": "CompanyCode",
          "isAvailableInMdx": false
        },
        {
          "type": "calculated",
          "name": "BookingDateLW",
          "dataType": "dateTime",
          "isHidden": true,
          "expression": "'fact_InventoryHistory'[BookingDate]+7",
          "formatString": "yyyy-MM-dd"
        },
        {
          "name": "BatchID",
          "dataType": "string",
          "sourceColumn": "BatchID",
          "lineageTag": "2bfdeba1-cc11-4197-ae33-5ecf35d7528d"
        },
        {
          "name": "InventoryStatusCode",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "InventoryStatusCode",
          "lineageTag": "2745843a-4ad7-455b-bf5e-1b68aaeb1327"
        },
        {
          "name": "InventoryTypeCode",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "InventoryTypeCode",
          "lineageTag": "16a1c64f-ccd9-42cb-9ece-b7ee5e41af33"
        },
        {
          "name": "SpecialStockIndicator",
          "dataType": "string",
          "sourceColumn": "SpecialStockIndicator",
          "lineageTag": "7b5ff9c1-de0b-4152-a8fa-8f7ed72c8226"
        },
        {
          "name": "GrossValue",
          "dataType": "decimal",
          "isHidden": true,
          "sourceColumn": "GrossValue",
          "lineageTag": "c6f99b1d-5fd2-438e-a7ed-7aa7d8e04cf1"
        },
        {
          "type": "calculated",
          "name": "AssignedSeasonCode",
          "dataType": "int64",
          "isDataTypeInferred": true,
          "isHidden": true,
          "expression": [
            "VAR ArticleNo = 'fact_InventoryHistory'[ArticleNumber_BK] // ALL ACTIVE PID SEASONS",
            "VAR ActivePIDSeasons =",
            "    FILTER (",
            "        'dim_Article_Season',",
            "        'dim_Article_Season'[ArticleNumber_BK] = ArticleNo",
            "            && [SourceSystem] <> \"PRM\" -- excl. PRM",
            "            && NOT ( [SourceSystem] = \"PAC\" )",
            "            && [ArticleCancelledStatus] = \"Active\" -- Active Articles only",
            "    ) // SEASON SELECTION",
            "-- take Max Season of active PID Seasons",
            "VAR Prio1 =",
            "    MAXX ( ActivePIDSeasons, [SeasonCode] )",
            "RETURN",
            "    -- if empty take any Max Season",
            "    IF (",
            "        ISBLANK ( Prio1 ),",
            "        MAXX (",
            "            FILTER (",
            "                'dim_Article_Season',",
            "                'dim_Article_Season'[ArticleNumber_BK] = ArticleNo",
            "            ),",
            "            [SeasonCode]",
            "        ),",
            "        Prio1",
            "    )"
          ],
          "isAvailableInMdx": false
        },
        {
          "name": "SourceSystem",
          "dataType": "string",
          "sourceColumn": "SourceSystem",
          "lineageTag": "3899d48c-f5e3-4cd0-ac73-bf3af9bda527"
        },
        {
          "name": "FirstAssortmentSemester",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "FirstAssortmentSemester",
          "lineageTag": "d4653ab9-25be-4a9d-a12a-d466829eadc0"
        },
        {
          "name": "LatestAssortmentSemester",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "LatestAssortmentSemester",
          "lineageTag": "40720ccd-1316-4dfd-8737-97495dcbd9af"
        }
      ],
      "partitions": [
        {
          "name": "vFACT_InventoryHistory_OnPrem_FRA",
          "source": {
            "type": "m",
            "expression": [
              "let query = \"SELECT",
              "     'BookingDate'              = DATEFROMPARTS( YEAR(GETDATE()) -2, 1, 1)",
              "    ,'ArticleNumber_BK'         = [ArticleNumber_BK]",
              "    ,'NatArticle_BK'            = replace([NatArticle_BK], '-1--1|FR10',Bii_NatArticle_BK)",
              "    ,'ArticleSize_BK'           = [ArticleSize_BK]",
              "    ,'StyleNumber_BK'           = isnull([StyleNumber_BK],0) ",
              "    ,'PDUCode'                  = [PDUCode]",
              "    ,'CompanyCode'              = 'FR10'",
              "    ,'PupMasterId'              = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'              = [ProdDivCode]",
              "    ,'RBUCode'                  = [RBUCode]",
              "    ,'BrandCode'                = [BrandCode]",
              "    ,'CurrencyCode'             = [CurrencyCode]",
              "    ,'NatStoreDC_BK'            = [NatStoreDC_BK]",
              "    ,'InventoryTypeCode'        = [InventoryTypeCode]                ",
              "    ,'InventoryStatusCode'      = trans.IntInventoryStatusCode",
              "    ,'InventoryType'            = [InventoryType]",
              "    ,'IntAgeingCode'            = [IntAgeingCode]",
              "    ,'BusinessTypeCode'         = 1",
              "    ,'InventoryUnits'           = SUM(trans.[Qty])",
              "    ,'StorageLocation'          = NULL",
              "    ,'StockSegment'             = NULL",
              "    ,'SpecialStockIndicator'    = NULL",
              "    ,'BatchID'                  = NULL",
              "    ,'GrossValue'               = CAST( SUM(trans.[GrossInventoryLC]) AS MONEY)",
              "    ,'SourceSystem'             = 'OnPrem'",
              "    ,'FirstAssortmentSemester'  = NULL",
              "    ,'LatestAssortmentSemester' = NULL",
              "",
              "",
              "FROM [sourcing].[vBII_InventoriesHistory_FRA_DL] trans ",
              "",
              "WHERE ",
              "    trans.[InventoryDate] < DATEFROMPARTS( YEAR(GETDATE()) -2, 1, 3)",
              "    AND trans.[IntDCTypeId] NOT IN (6) -- Exclude Retail Stores",
              "    AND trans.[IntPupMasterId] = 32",
              "",
              "",
              "GROUP BY",
              "[ArticleNumber_BK]",
              ",replace([NatArticle_BK], '-1--1|FR10',Bii_NatArticle_BK)",
              ",[ArticleSize_BK]",
              ",isnull([StyleNumber_BK],0) ",
              ",[PDUCode]",
              ",trans.[IntPupMasterId]",
              ",[ProdDivCode]",
              ",[RBUCode]",
              ",[BrandCode]",
              ",[CurrencyCode]",
              ",[NatStoreDC_BK]",
              ",[InventoryTypeCode]                ",
              ",trans.IntInventoryStatusCode",
              ",[InventoryType]",
              ",[IntAgeingCode]",
              "HAVING",
              "    SUM(trans.[Qty]) <> 0",
              "",
              "UNION ALL",
              "",
              "/* BOOKINGS SINCE -3 YEARS **/",
              "",
              "SELECT",
              "     'BookingDate'              = DATEADD(d, -1, CAST( trans.[InventoryDate] AS DATE))",
              "    ,'ArticleNumber_BK'         = [ArticleNumber_BK]",
              "    ,'NatArticle_BK'            = replace([NatArticle_BK], '-1--1|FR10',Bii_NatArticle_BK)",
              "    ,'ArticleSize_BK'           = [ArticleSize_BK]",
              "    ,'StyleNumber_BK'           = isnull([StyleNumber_BK],0) ",
              "    ,'PDUCode'                  = [PDUCode]",
              "    ,'CompanyCode'              = 'FR10'",
              "    ,'PupMasterId'              = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'              = [ProdDivCode]",
              "    ,'RBUCode'                  = [RBUCode]",
              "    ,'BrandCode'                = [BrandCode]",
              "    ,'CurrencyCode'             = [CurrencyCode]",
              "    ,'NatStoreDC_BK'            = [NatStoreDC_BK]",
              "    ,'InventoryTypeCode'        = [InventoryTypeCode]                ",
              "    ,'InventoryStatusCode'      = trans.IntInventoryStatusCode",
              "    ,'InventoryType'            = [InventoryType]",
              "    ,'IntAgeingCode'            = [IntAgeingCode]",
              "    ,'BusinessTypeCode'         = 1",
              "    ,'InventoryUnits'           = SUM(trans.[Qty])",
              "    ,'StorageLocation'          = NULL",
              "    ,'StockSegment'             = NULL",
              "    ,'SpecialStockIndicator'    = NULL",
              "    ,'BatchID'                  = NULL",
              "    ,'GrossValue'               = CAST( SUM(trans.[GrossInventoryLC]) AS MONEY)",
              "    ,'SourceSystem'             = 'OnPrem'",
              "    ,'FirstAssortmentSemester'  = NULL",
              "    ,'LatestAssortmentSemester' = NULL",
              "",
              "",
              "FROM [sourcing].[vBII_InventoriesHistory_FRA_DL] trans ",
              "",
              "",
              "WHERE ",
              "    trans.[InventoryDate] >= DATEFROMPARTS( YEAR(GETDATE()) -2, 1, 3)  and trans.[InventoryDate] < DATEFROMPARTS( 2024, 3, 24)",
              "    AND trans.[IntDCTypeId] NOT IN (6) -- Exclude Retail Stores",
              "    AND trans.[IntPupMasterId] = 32",
              "    ",
              "",
              "GROUP BY",
              "       ",
              "        trans.[InventoryDate]",
              "        ,[ArticleNumber_BK]",
              "        ,replace([NatArticle_BK], '-1--1|FR10',Bii_NatArticle_BK)",
              "        ,[ArticleSize_BK]",
              "        ,isnull([StyleNumber_BK],0) ",
              "        ,[PDUCode]",
              "        ,trans.[IntPupMasterId]",
              "        ,[ProdDivCode]",
              "        ,[RBUCode]",
              "        ,[BrandCode]",
              "        ,[CurrencyCode]",
              "        ,[NatStoreDC_BK]",
              "        ,[InventoryTypeCode]                ",
              "        ,trans.IntInventoryStatusCode",
              "        ,[InventoryType]",
              "        ,[IntAgeingCode]",
              "   \",",
              "",
              "connAS_SE = Sql.Database(Param_Server_EU_SSP,Param_Database_EUR_PDW_FRA_SSP),",
              "Source = Value.NativeQuery(connAS_SE, query)",
              "in",
              "    Source"
            ]
          }
        },
        {
          "name": "vFACT_InventoryHistory_OnPrem_Crossbookings_FRA",
          "source": {
            "type": "m",
            "expression": [
              "let query = \"SELECT",
              "     'BookingDate'              = DATEFROMPARTS( 2024, 4, 1)",
              "    ,'ArticleNumber_BK'         = [ArticleNumber_BK]",
              "    ,'NatArticle_BK'            = replace([NatArticle_BK], '-1--1|FR10',Bii_NatArticle_BK)",
              "    ,'ArticleSize_BK'           = [ArticleSize_BK]",
              "    ,'StyleNumber_BK'           = isnull([StyleNumber_BK],0) ",
              "    ,'PDUCode'                  = [PDUCode]",
              "    ,'CompanyCode'              = 'FR10'",
              "    ,'PupMasterId'              = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'              = [ProdDivCode]",
              "    ,'RBUCode'                  = [RBUCode]",
              "    ,'BrandCode'                = [BrandCode]",
              "    ,'CurrencyCode'             = [CurrencyCode]",
              "    ,'NatStoreDC_BK'            = [NatStoreDC_BK]",
              "    ,'InventoryTypeCode'        = [InventoryTypeCode]                ",
              "    ,'InventoryStatusCode'      = trans.IntInventoryStatusCode",
              "    ,'InventoryType'            = [InventoryType]",
              "    ,'IntAgeingCode'            = [IntAgeingCode]",
              "    ,'BusinessTypeCode'         = 1",
              "    ,'InventoryUnits'           = SUM(trans.[Qty]) * -1",
              "    ,'StorageLocation'          = NULL",
              "    ,'StockSegment'             = NULL",
              "    ,'SpecialStockIndicator'    = NULL",
              "    ,'BatchID'                  = NULL",
              "    ,'GrossValue'               = CAST( SUM(trans.[GrossInventoryLC]) AS MONEY) * -1",
              "    ,'SourceSystem'             = 'OnPrem'",
              "    ,'FirstAssortmentSemester'  = NULL",
              "    ,'LatestAssortmentSemester' = NULL",
              "",
              "",
              "FROM [sourcing].[vBII_InventoriesHistory_FRA_DL] trans ",
              "",
              "WHERE ",
              "    trans.[InventoryDate]  < DATEFROMPARTS( 2024, 3, 24)",
              "    AND trans.[IntDCTypeId] NOT IN (6) -- Exclude Retail Stores",
              "    AND trans.[IntPupMasterId] = 32",
              "",
              "",
              "GROUP BY",
              "[ArticleNumber_BK]",
              ",replace([NatArticle_BK], '-1--1|FR10',Bii_NatArticle_BK)",
              ",[ArticleSize_BK]",
              ",isnull([StyleNumber_BK],0) ",
              ",[PDUCode]",
              ",trans.[IntPupMasterId]",
              ",[ProdDivCode]",
              ",[RBUCode]",
              ",[BrandCode]",
              ",[CurrencyCode]",
              ",[NatStoreDC_BK]",
              ",[InventoryTypeCode]                ",
              ",trans.IntInventoryStatusCode",
              ",[InventoryType]",
              ",[IntAgeingCode]",
              "HAVING",
              "    SUM(trans.[Qty]) <> 0",
              "",
              "   \",",
              "",
              "connAS_SE = Sql.Database(Param_Server_EU_SSP,Param_Database_EUR_PDW_FRA_SSP),",
              "",
              "Source = Value.NativeQuery(connAS_SE, query)",
              "in",
              "    Source"
            ]
          }
        },
        {
          "name": "vFACT_InventoryHistory_DBX_FRA_CY",
          "source": {
            "type": "m",
            "expression": [
              "let query = \"",
              "SELECT",
              "     EU.PostingDate               AS BookingDate,",
              "     EU.ArticleNumber_BK          AS ArticleNumber_BK,",
              "     EU.NatArticle_BK             AS NatArticle_BK,",
              "     EU.ArticleSize_BK            AS ArticleSize_BK,",
              "     EU.StyleNumber_BK            AS StyleNumber_BK,",
              "     EU.PDUCode                   AS PDUCode,",
              "     EU.CompanyCode               AS CompanyCode,",
              "     EU.IntPupMasterId            AS PupMasterId,",
              "     EU.ProdDivCode               AS ProdDivCode,",
              "     EU.RBUCode                   AS RBUCode,",
              "     EU.BrandCode                 AS BrandCode,",
              "     EU.PriceCurrency             AS CurrencyCode,",
              "     EU.NatStoreDC_BK             AS NatStoreDC_BK,",
              "     EU.IntInventoryTypeCode      AS InventoryTypeCode,",
              "     EU.IntInventoryStatusCode    AS InventoryStatusCode,",
              "     EU.QtyType                   AS InventoryType,",
              "     EU.IntAgeingCode             AS IntAgeingCode,",
              "     EU.BusinessTypeCode          AS BusinessTypeCode,",
              "     EU.Qty                       AS InventoryUnits,",
              "     EU.StorageLocation           AS StorageLocation,",
              "     EU.StockSegment              AS StockSegment,",
              "     EU.SpecialStockIndicator     AS SpecialStockIndicator,",
              "     EU.BatchID                   AS BatchID,",
              "     EU.Gross                     AS GrossValue,",
              "   CAST(LEFT(SS.FirstAssortment,5) AS INT)     AS FirstAssortmentSemester,",
              "   CAST(LEFT(SS.LatestAssortment,5) AS INT)   AS LatestAssortmentSemester,",
              "     'DBX'                        AS SourceSystem",
              "     ",
              "FROM s3_gold.fact_inventory_snapshot_bridge_eu EU",
              "LEFT JOIN s3_gold.vw_inventory_material_assortment_semester SS",
              "    ON EU.Material = SS.Material",
              "   AND EU.CompanyCode = SS.CompanyCode",
              "",
              "WHERE EU.PostingDate >= TRUNC(CURRENT_DATE(), 'YEAR')",
              "AND EU.CompanyCode = 'FR10'",
              "  \",",
              "",
              "Source = Databricks.Catalogs(ServerHostname_EEMEA, HTTPPath_EEMEA, [Catalog=Catalog_EEMEA]),",
              "",
              "Database = Source{[Name=Catalog_EEMEA, Kind=\"Database\"]}[Data],",
              "",
              "Result = Value.NativeQuery(Database, query, null, [EnableFolding = true])",
              "",
              "",
              "in",
              "",
              "    Result"
            ]
          }
        },
        {
          "name": "vFACT_InventoryHistory_DBX_FRA_History",
          "source": {
            "type": "m",
            "expression": [
              "let query = \"",
              "SELECT",
              "     EU.PostingDate               AS BookingDate,",
              "     EU.ArticleNumber_BK          AS ArticleNumber_BK,",
              "     EU.NatArticle_BK             AS NatArticle_BK,",
              "     EU.ArticleSize_BK            AS ArticleSize_BK,",
              "     EU.StyleNumber_BK            AS StyleNumber_BK,",
              "     EU.PDUCode                   AS PDUCode,",
              "     EU.CompanyCode               AS CompanyCode,",
              "     EU.IntPupMasterId            AS PupMasterId,",
              "     EU.ProdDivCode               AS ProdDivCode,",
              "     EU.RBUCode                   AS RBUCode,",
              "     EU.BrandCode                 AS BrandCode,",
              "     EU.PriceCurrency             AS CurrencyCode,",
              "     EU.NatStoreDC_BK             AS NatStoreDC_BK,",
              "     EU.IntInventoryTypeCode      AS InventoryTypeCode,",
              "     EU.IntInventoryStatusCode    AS InventoryStatusCode,",
              "     EU.QtyType                   AS InventoryType,",
              "     EU.IntAgeingCode             AS IntAgeingCode,",
              "     EU.BusinessTypeCode          AS BusinessTypeCode,",
              "     EU.Qty                       AS InventoryUnits,",
              "     EU.StorageLocation           AS StorageLocation,",
              "     EU.StockSegment              AS StockSegment,",
              "     EU.SpecialStockIndicator     AS SpecialStockIndicator,",
              "     EU.BatchID                   AS BatchID,",
              "     EU.Gross                     AS GrossValue,",
              "   LEFT(SS.FirstAssortment,5)     AS FirstAssortmentSemester,",
              "   LEFT(SS.LatestAssortment,5)    AS LatestAssortmentSemester,",
              "     'DBX'                        AS SourceSystem",
              "     ",
              "FROM s3_gold.fact_inventory_snapshot_bridge_eu EU",
              "LEFT JOIN s3_gold.vw_inventory_material_assortment_semester SS",
              "    ON EU.Material = SS.Material",
              "   AND EU.CompanyCode = SS.CompanyCode",
              "",
              "WHERE EU.PostingDate < make_date(year(current_date()), 1, 1)",
              "AND EU.CompanyCode = 'FR10'",
              "  \",",
              "",
              "Source = Databricks.Catalogs(ServerHostname_EEMEA, HTTPPath_EEMEA, [Catalog=Catalog_EEMEA]),",
              "",
              "Database = Source{[Name=Catalog_EEMEA, Kind=\"Database\"]}[Data],",
              "",
              "Result = Value.NativeQuery(Database, query, null, [EnableFolding = true])",
              "",
              "",
              "in",
              "",
              "    Result",
              "    ",
              "    "
            ]
          }
        },
        {
          "name": "vFACT_InventoryHistory_SP_FRA",
          "source": {
            "type": "m",
            "expression": [
              "let query = \"",
              "",
              "/* Aggregation of - 2 years units */",
              "SELECT ",
              "     'BookingDate'               = DATEFROMPARTS( YEAR(GETDATE()) - 2, 1, 1)",
              "    ,'ArticleNumber_BK'          = trans.ArticleNumber_BK",
              "    ,'NatArticle_BK'             = trans.[NatArticle_BK]",
              "    ,'ArticleSize_BK'            = trans.[ArticleSize_BK]",
              "    ,'StyleNumber_BK'            = trans.[StyleNumber_BK]",
              "    ,'PDUCode'                   = trans.[PDUCode]",
              "    ,'CompanyCode'               = trans.COMPANYCODE",
              "    ,'PupMasterId'               = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'               = trans.[ProdDivCode]",
              "    ,'RBUCode'                   = trans.[RBUCode]",
              "    ,'BrandCode'                 = trans.[BrandCode]",
              "    ,'CurrencyCode'              = trans.[PRICECURRENCY]",
              "    ,'NatStoreDC_BK'             = trans.[NatStoreDC_BK]",
              "    ,'InventoryTypeCode'         = trans.[IntInventoryTypeCode]",
              "    ,'InventoryStatusCode'       = trans.IntInventoryStatusCode",
              "    ,'InventoryType'             = trans.QTYTYPE",
              "    ,'IntAgeingCode'             = trans.[IntAgeingCode]",
              "    ,'BusinessTypeCode'          = BusinessTypeCode",
              "    ,'InventoryUnits'            = SUM(trans.[Qty])",
              "    ,'StorageLocation'           = STORAGELOCATION",
              "    ,'StockSegment'              = trans.stocksegment",
              "    ,'SpecialStockIndicator'     = trans.SPECIALSTOCKINDICATOR",
              "    ,'BatchID'                   = trans.BatchID",
              "    ,'GrossValue'                = SUM(GROSS)",
              "    ,'SourceSystem'              = 'EBP'",
              "    ,'FirstAssortmentSemester'   = cast(Left(ISNULL(nart.FirstAssortment, ''),5) as int)",
              "    ,'LatestAssortmentSemester'  = cast(left(ISNULL(nart.LatestAssortment, ''),5) as int)",
              "FROM [sourcing].[InventoriesHistory] trans with(nolock)",
              "left join ref.NatArticles nart on nart.[NatArticle_BK] = trans.[NatArticle_BK]",
              "WHERE trans.[PostingDate] < DATEFROMPARTS( YEAR(GETDATE()) - 2, 1, 1)",
              "  AND trans.[CompanyCode] = 'FR10'",
              "GROUP BY",
              "     trans.ArticleNumber_BK",
              "    ,trans.[NatArticle_BK]",
              "    ,trans.[ArticleSize_BK]",
              "    ,trans.[StyleNumber_BK]",
              "    ,trans.[PDUCode]",
              "    ,trans.COMPANYCODE",
              "    ,trans.[IntPupMasterId]",
              "    ,trans.[ProdDivCode]",
              "    ,trans.[RBUCode]",
              "    ,trans.[BrandCode]",
              "    ,trans.[PRICECURRENCY]",
              "    ,trans.[NatStoreDC_BK]",
              "    ,trans.[IntInventoryTypeCode]",
              "    ,trans.IntInventoryStatusCode",
              "    ,trans.QTYTYPE",
              "    ,trans.[IntAgeingCode]",
              "    ,BusinessTypeCode",
              "    ,STORAGELOCATION",
              "    ,trans.stocksegment",
              "    ,trans.SPECIALSTOCKINDICATOR",
              "    ,trans.BatchID",
              "    ,nart.FirstAssortment",
              "    ,nart.LatestAssortment",
              "HAVING SUM(trans.[Qty]) <> 0",
              "",
              "union all",
              "",
              "SELECT ",
              "     'BookingDate'               = dateadd(d, -1, CAST( trans.[PostingDate] AS DATE))",
              "    ,'ArticleNumber_BK'          = trans.ArticleNumber_BK",
              "    ,'NatArticle_BK'             = trans.[NatArticle_BK]",
              "    ,'ArticleSize_BK'            = trans.[ArticleSize_BK]",
              "    ,'StyleNumber_BK'            = trans.[StyleNumber_BK]",
              "    ,'PDUCode'                   = trans.[PDUCode]",
              "    ,'CompanyCode'               = trans.COMPANYCODE",
              "    ,'PupMasterId'               = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'               = trans.[ProdDivCode]",
              "    ,'RBUCode'                   = trans.[RBUCode]",
              "    ,'BrandCode'                 = trans.[BrandCode]",
              "    ,'CurrencyCode'              = trans.[PRICECURRENCY]",
              "    ,'NatStoreDC_BK'             = trans.[NatStoreDC_BK]",
              "    ,'InventoryTypeCode'         = trans.[IntInventoryTypeCode]",
              "    ,'InventoryStatusCode'       = trans.IntInventoryStatusCode",
              "    ,'InventoryType'             = trans.QTYTYPE",
              "    ,'IntAgeingCode'             = trans.[IntAgeingCode]",
              "    ,'BusinessTypeCode'          = BusinessTypeCode",
              "    ,'InventoryUnits'            = trans.[Qty]",
              "    ,'StorageLocation'           = STORAGELOCATION",
              "    ,'StockSegment'              = trans.stocksegment",
              "    ,'SpecialStockIndicator'     = trans.SPECIALSTOCKINDICATOR",
              "    ,'BatchID'                   = trans.BatchID",
              "    ,'GrossValue'                = GROSS",
              "    ,'SourceSystem'              = 'EBP'",
              "    ,'FirstAssortmentSemester'   = cast(Left(ISNULL(nart.FirstAssortment, ''),5) as int)",
              "    ,'LatestAssortmentSemester'  = cast(left(ISNULL(nart.LatestAssortment, ''),5) as int)",
              "FROM [sourcing].[InventoriesHistory] trans with(nolock)",
              "left join ref.NatArticles nart on nart.[NatArticle_BK] = trans.[NatArticle_BK]",
              "WHERE trans.[PostingDate] >= DATEFROMPARTS( YEAR(GETDATE())-2,01,01)  ",
              "  AND trans.[PostingDate] < '20260701' ",
              "  AND trans.[CompanyCode] = 'FR10'",
              "",
              "/* Crossbookings */",
              "",
              "union all",
              "",
              "SELECT ",
              "     'BookingDate'               = DATEFROMPARTS(2026,07,01)",
              "    ,'ArticleNumber_BK'          = trans.ArticleNumber_BK",
              "    ,'NatArticle_BK'             = trans.[NatArticle_BK]",
              "    ,'ArticleSize_BK'            = trans.[ArticleSize_BK]",
              "    ,'StyleNumber_BK'            = trans.[StyleNumber_BK]",
              "    ,'PDUCode'                   = trans.[PDUCode]",
              "    ,'CompanyCode'               = trans.COMPANYCODE",
              "    ,'PupMasterId'               = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'               = trans.[ProdDivCode]",
              "    ,'RBUCode'                   = trans.[RBUCode]",
              "    ,'BrandCode'                 = trans.[BrandCode]",
              "    ,'CurrencyCode'              = trans.[PRICECURRENCY]",
              "    ,'NatStoreDC_BK'             = trans.[NatStoreDC_BK]",
              "    ,'InventoryTypeCode'         = trans.[IntInventoryTypeCode]",
              "    ,'InventoryStatusCode'       = trans.IntInventoryStatusCode",
              "    ,'InventoryType'             = trans.QTYTYPE",
              "    ,'IntAgeingCode'             = trans.[IntAgeingCode]",
              "    ,'BusinessTypeCode'          = BusinessTypeCode",
              "    ,'InventoryUnits'            = sum(trans.[Qty]) * -1",
              "    ,'StorageLocation'           = STORAGELOCATION",
              "    ,'StockSegment'              = trans.stocksegment",
              "    ,'SpecialStockIndicator'     = trans.SPECIALSTOCKINDICATOR",
              "    ,'BatchID'                   = trans.BatchID",
              "    ,'GrossValue'                = sum(GROSS) * -1",
              "    ,'SourceSystem'              = 'EBP'",
              "    ,'FirstAssortmentSemester'   = cast(Left(ISNULL(nart.FirstAssortment, ''),5) as int)",
              "    ,'LatestAssortmentSemester'  = cast(left(ISNULL(nart.LatestAssortment, ''),5) as int)",
              "FROM [sourcing].[InventoriesHistory] trans with(nolock)",
              "left join ref.NatArticles nart on nart.[NatArticle_BK] = trans.[NatArticle_BK]",
              "WHERE trans.[PostingDate] < '20260701' ",
              "  AND trans.[CompanyCode] = 'FR10'",
              "GROUP BY",
              "     trans.ArticleNumber_BK",
              "    ,trans.[NatArticle_BK]",
              "    ,trans.[ArticleSize_BK]",
              "    ,trans.[StyleNumber_BK]",
              "    ,trans.[PDUCode]",
              "    ,trans.COMPANYCODE",
              "    ,trans.[IntPupMasterId]",
              "    ,trans.[ProdDivCode]",
              "    ,trans.[RBUCode]",
              "    ,trans.[BrandCode]",
              "    ,trans.[PRICECURRENCY]",
              "    ,trans.[NatStoreDC_BK]",
              "    ,trans.[IntInventoryTypeCode]",
              "    ,trans.IntInventoryStatusCode",
              "    ,trans.QTYTYPE",
              "    ,trans.[IntAgeingCode]",
              "    ,BusinessTypeCode",
              "    ,STORAGELOCATION",
              "    ,trans.stocksegment",
              "    ,trans.SPECIALSTOCKINDICATOR",
              "    ,trans.BatchID",
              "    ,nart.FirstAssortment",
              "    ,nart.LatestAssortment",
              "HAVING SUM(trans.[Qty]) <> 0  ",
              "   \",",
              "",
              "connAS_SE = Sql.Database(Param_Server_Europe_SP, Param_Database_FRA_SP),",
              "",
              "Source = Value.NativeQuery(connAS_SE, query)",
              "in",
              "    Source"
            ]
          }
        }
      ],
      "annotations": [
        {
          "name": "#Marketing_Hidden"
        }
      ]
    }
  }
}