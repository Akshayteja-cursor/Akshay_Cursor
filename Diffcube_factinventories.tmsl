          "sourceColumn": "GrossValue",
          "lineageTag": "c6f99b1d-5fd2-438e-a7ed-7aa7d8e04cf1"
        },
        {
          "type": "calculated",
          "name": "AssignedSeasonCode",
          "dataType": "int64",
          "isDataTypeInferred": true,
          "isHidden": true,
          "expression": [
            "VAR ArticleNo = 'fact_InventoryHistory'[ArticleNumber_BK] // ALL ACTIVE PID SEASONS",
            "VAR ActivePIDSeasons =",
            "    FILTER (",
            "        'dim_Article_Season',",
            "        'dim_Article_Season'[ArticleNumber_BK] = ArticleNo",
            "            && [SourceSystem] <> \"PRM\" -- excl. PRM",
            "            && NOT ( [SourceSystem] = \"PAC\" )",
            "            && [ArticleCancelledStatus] = \"Active\" -- Active Articles only",
            "    ) // SEASON SELECTION",
            "-- take Max Season of active PID Seasons",
            "VAR Prio1 =",
            "    MAXX ( ActivePIDSeasons, [SeasonCode] )",
            "RETURN",
            "    -- if empty take any Max Season",
            "    IF (",
            "        ISBLANK ( Prio1 ),",
            "        MAXX (",
            "            FILTER (",
            "                'dim_Article_Season',",
            "                'dim_Article_Season'[ArticleNumber_BK] = ArticleNo",
            "            ),",
            "            [SeasonCode]",
            "        ),",
            "        Prio1",
            "    )"
          ],
          "isAvailableInMdx": false
        },
        {
          "name": "FirstAssortmentSemester",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "FirstAssortmentSemester",
          "lineageTag": "528d4615-2e19-4775-96e1-8061b6eb924a"
        },
        {
          "name": "LatestAssortmentSemester",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "LatestAssortmentSemester",
          "lineageTag": "8a77c164-90b4-421e-9ebc-0441ed1524cf"
        },
        {
          "name": "SourceSystem",
          "dataType": "string",
          "sourceColumn": "SourceSystem",
          "lineageTag": "671336e6-dd4d-4b1b-b191-4fb19118bf1b"
        }
      ],
      "partitions": [
        {
          "name": "vFACT_InventoryHistory_DBX_SE_CY",
          "source": {
            "type": "m",
            "expression": [
              "let ",
              "    query = \"SELECT ",
              "         POSTINGDATE                AS BookingDate ",
              "        ,ArticleNumber_BK           AS ArticleNumber_BK       ",
              "        ,NatArticle_BK              AS NatArticle_BK   ",
              "        ,ArticleSize_BK             AS ArticleSize_BK       ",
              "        ,StyleNumber_BK             AS StyleNumber_BK              ",
              "        ,PDUCode                    AS PDUCode ",
              "        ,COMPANYCODE                AS CompanyCode               ",
              "        ,IntPupMasterId             AS PupMasterId",
              "        ,ProdDivCode                AS ProdDivCode     ",
              "        ,RBUCode                    AS RBUCode               ",
              "        ,BrandCode                  AS BrandCode             ",
              "        ,PRICECURRENCY              AS CurrencyCode        ",
              "        ,CASE",
              "    WHEN length(natstoredc_bk) >= 4",
              "      THEN CONCAT(substr(natstoredc_bk, 1, length(natstoredc_bk) - 4), 'EU')",
              "    ELSE natstoredc_bk",
              "    END                             AS NatStoreDC_BK",
              "        ,IntInventoryTypeCode       AS InventoryTypeCode ",
              "        ,IntInventoryStatusCode     AS InventoryStatusCode",
              "        ,QTYTYPE                    AS InventoryType ",
              "        ,IntAgeingCode              AS IntAgeingCode",
              "        ,BusinessTypeCode           AS BusinessTypeCode",
              "        ,QTY                        AS InventoryUnits",
              "        ,STORAGELOCATION            AS StorageLocation",
              "        ,STOCKSEGMENT               AS StockSegment",
              "        ,SPECIALSTOCKINDICATOR      AS SpecialStockIndicator",
              "        ,PLANT                      AS Plant",
              "        ,BATCHID                    AS BatchID                 ",
              "        ,PRICE                      AS Price",
              "        ,MATERIAL                   AS Material",
              "        ,VALUE                      AS Value",
              "        ,GROSS                      AS GrossValue ",
              "        ,FirstAssortmentSemester    AS FirstAssortmentSemester",
              "        ,LatestAssortmentSemester   AS LatestAssortmentSemester",
              "        ,'DBX'                      AS SourceSystem",
              "  FROM s3_gold.fact_inventory_snapshot_bridge_eu",
              "  WHERE PostingDate  >= trunc(current_date(), 'YEAR')",
              "  AND plant        <> 'IT90'",
              "  AND CompanyCode  IN ('PT10', 'ES10', 'IT10')",
              "  AND stocksegment NOT IN ('FPC') \",",
              "",
              "    Source = Databricks.Catalogs(ServerHostname_EEMEA, HTTPPath_EEMEA, [Catalog=Catalog_EEMEA]),",
              "    Database = Source{[Name=Catalog_EEMEA, Kind=\"Database\"]}[Data],",
              "    Result = Value.NativeQuery(Database, query, null, [EnableFolding = false])",
              "in",
              "    Result",
              "    ",
              "    ",
              "   "
            ]
          }
        },
        {
          "name": "vFACT_InventoryHistory_DBX_SE_History",
          "source": {
            "type": "m",
            "expression": [
              "let ",
              "    query = \"SELECT ",
              "         POSTINGDATE                AS BookingDate ",
              "        ,ArticleNumber_BK           AS ArticleNumber_BK       ",
              "        ,NatArticle_BK              AS NatArticle_BK   ",
              "        ,ArticleSize_BK             AS ArticleSize_BK       ",
              "        ,StyleNumber_BK             AS StyleNumber_BK              ",
              "        ,PDUCode                    AS PDUCode ",
              "        ,COMPANYCODE                AS CompanyCode               ",
              "        ,IntPupMasterId             AS PupMasterId",
              "        ,ProdDivCode                AS ProdDivCode     ",
              "        ,RBUCode                    AS RBUCode               ",
              "        ,BrandCode                  AS BrandCode             ",
              "        ,PRICECURRENCY              AS CurrencyCode        ",
              "        ,CASE",
              "    WHEN length(natstoredc_bk) >= 4",
              "      THEN CONCAT(substr(natstoredc_bk, 1, length(natstoredc_bk) - 4), 'EU')",
              "    ELSE natstoredc_bk",
              "    END                             AS NatStoreDC_BK",
              "        ,IntInventoryTypeCode       AS InventoryTypeCode ",
              "        ,IntInventoryStatusCode     AS InventoryStatusCode",
              "        ,QTYTYPE                    AS InventoryType ",
              "        ,IntAgeingCode              AS IntAgeingCode",
              "        ,BusinessTypeCode           AS BusinessTypeCode",
              "        ,QTY                        AS InventoryUnits",
              "        ,STORAGELOCATION            AS StorageLocation",
              "        ,STOCKSEGMENT               AS StockSegment",
              "        ,SPECIALSTOCKINDICATOR      AS SpecialStockIndicator",
              "        ,PLANT                      AS Plant",
              "        ,BATCHID                    AS BatchID                 ",
              "        ,PRICE                      AS Price",
              "        ,MATERIAL                   AS Material",
              "        ,VALUE                      AS Value",
              "        ,GROSS                      AS GrossValue ",
              "        ,FirstAssortmentSemester    AS FirstAssortmentSemester",
              "        ,LatestAssortmentSemester   AS LatestAssortmentSemester",
              "        ,'DBX'                      AS SourceSystem",
              "  FROM s3_gold.fact_inventory_snapshot_bridge_eu",
              "  WHERE PostingDate  < make_date(year(current_date()), 1, 1)",
              "  AND plant        <> 'IT90'",
              "  AND CompanyCode  IN ('PT10', 'ES10', 'IT10')",
              "  AND stocksegment NOT IN ('FPC') ",
              "",
              " \",",
              "    ",
              "    Source = Databricks.Catalogs(ServerHostname_EEMEA, HTTPPath_EEMEA, [Catalog=Catalog_EEMEA]),",
              "    Database = Source{[Name=Catalog_EEMEA, Kind=\"Database\"]}[Data],",
              "    Result = Value.NativeQuery(Database, query, null, [EnableFolding = false])",
              "in",
              "    Result",
              "    ",
              "    ",
              "    ",
              "   "
            ]
          }
        },
        {
          "name": "vFACT_InventoryHistory_SP_SE",
          "source": {
            "type": "m",
            "expression": [
              "let query = \"",
              "",
              "/* Aggregation of - 2 years units */",
              "SELECT ",
              "     'BookingDate'               = DATEFROMPARTS( YEAR(GETDATE()) - 2, 1, 1)",
              "    ,'ArticleNumber_BK'          = trans.ArticleNumber_BK",
              "    ,'NatArticle_BK'             = trans.[NatArticle_BK]",
              "    ,'ArticleSize_BK'            = trans.[ArticleSize_BK]",
              "    ,'StyleNumber_BK'            = trans.[StyleNumber_BK]",
              "    ,'PDUCode'                   = trans.[PDUCode]",
              "    ,'CompanyCode'               = trans.COMPANYCODE",
              "    ,'PupMasterId'               = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'               = trans.[ProdDivCode]",
              "    ,'RBUCode'                   = trans.[RBUCode]",
              "    ,'BrandCode'                 = trans.[BrandCode]",
              "    ,'CurrencyCode'              = trans.[PRICECURRENCY]",
              "    ,'NatStoreDC_BK'             = CASE WHEN LEN(trans.[NatStoreDC_BK]) >= 4 THEN LEFT(trans.[NatStoreDC_BK], LEN(trans.[NatStoreDC_BK]) - 4) + 'EU' ELSE trans.[NatStoreDC_BK] END",
              "    ,'InventoryTypeCode'         = trans.[IntInventoryTypeCode]",
              "    ,'InventoryStatusCode'       = trans.IntInventoryStatusCode",
              "    ,'InventoryType'             = trans.QTYTYPE",
              "    ,'IntAgeingCode'             = trans.[IntAgeingCode]",
              "    ,'BusinessTypeCode'          = BusinessTypeCode",
              "    ,'InventoryUnits'            = sum(trans.[Qty])",
              "    ,'StorageLocation'           = STORAGELOCATION",
              "    ,'StockSegment'              = trans.stocksegment",
              "    ,'SpecialStockIndicator'     = trans.SPECIALSTOCKINDICATOR",
              "    ,'Plant'                     = trans.plant",
              "    ,'BatchID'                   = trans.BatchID",
              "    ,'Price'                     = trans.price",
              "    ,'Material'                  = trans.material",
              "    ,'Value'                     = sum(trans.[value])",
              "    ,'GrossValue'                = sum(GROSS)",
              "    ,'FirstAssortmentSemester'   = cast(Left(ISNULL(nart.FirstAssortment, ''),5) as int)",
              "    ,'LatestAssortmentSemester'  = cast(left(ISNULL(nart.LatestAssortment, ''),5) as int)",
              "    ,'SourceSystem'              = 'EBP'",
              "FROM [sourcing].[InventoriesHistory] trans with(nolock)",
              "left join ref.NatArticles nart on nart.[NatArticle_BK] = trans.[NatArticle_BK]",
              "WHERE trans.[PostingDate] < DATEFROMPARTS( YEAR(GETDATE()) - 2, 1, 1)",
              "  AND trans.plant <> 'IT90'",
              "  AND trans.CompanyCode in ('PT10','ES10','IT10')",
              "  AND stocksegment not in ('FPC')",
              "GROUP BY",
              "     trans.ArticleNumber_BK",
              "    ,trans.[NatArticle_BK]",
              "    ,trans.[ArticleSize_BK]",
              "    ,trans.[StyleNumber_BK]",
              "    ,trans.[PDUCode]",
              "    ,trans.COMPANYCODE",
              "    ,trans.[IntPupMasterId]",
              "    ,trans.[ProdDivCode]",
              "    ,trans.[RBUCode]",
              "    ,trans.[BrandCode]",
              "    ,trans.[PRICECURRENCY]",
              "    ,trans.[NatStoreDC_BK]",
              "    ,trans.[IntInventoryTypeCode]",
              "    ,trans.IntInventoryStatusCode",
              "    ,trans.QTYTYPE",
              "    ,trans.[IntAgeingCode]",
              "    ,BusinessTypeCode",
              "    ,STORAGELOCATION",
              "    ,trans.stocksegment",
              "    ,trans.SPECIALSTOCKINDICATOR",
              "    ,trans.plant",
              "    ,trans.BatchID",
              "    ,trans.price",
              "    ,trans.material",
              "    ,nart.FirstAssortment",
              "    ,nart.LatestAssortment",
              "HAVING SUM(trans.[Qty]) <> 0",
              "",
              "union all",
              "",
              "SELECT ",
              "     'BookingDate'               = dateadd(d, -1, CAST( trans.[PostingDate] AS DATE))",
              "    ,'ArticleNumber_BK'          = trans.ArticleNumber_BK",
              "    ,'NatArticle_BK'             = trans.[NatArticle_BK]",
              "    ,'ArticleSize_BK'            = trans.[ArticleSize_BK]",
              "    ,'StyleNumber_BK'            = trans.[StyleNumber_BK]",
              "    ,'PDUCode'                   = trans.[PDUCode]",
              "    ,'CompanyCode'               = trans.COMPANYCODE",
              "    ,'PupMasterId'               = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'               = trans.[ProdDivCode]",
              "    ,'RBUCode'                   = trans.[RBUCode]",
              "    ,'BrandCode'                 = trans.[BrandCode]",
              "    ,'CurrencyCode'              = trans.[PRICECURRENCY]",
              "    ,'NatStoreDC_BK'             = CASE WHEN LEN(trans.[NatStoreDC_BK]) >= 4 THEN LEFT(trans.[NatStoreDC_BK], LEN(trans.[NatStoreDC_BK]) - 4) + 'EU' ELSE trans.[NatStoreDC_BK] END",
              "    ,'InventoryTypeCode'         = trans.[IntInventoryTypeCode]",
              "    ,'InventoryStatusCode'       = trans.IntInventoryStatusCode",
              "    ,'InventoryType'             = trans.QTYTYPE",
              "    ,'IntAgeingCode'             = trans.[IntAgeingCode]",
              "    ,'BusinessTypeCode'          = BusinessTypeCode",
              "    ,'InventoryUnits'            = trans.[Qty]",
              "    ,'StorageLocation'           = STORAGELOCATION",
              "    ,'StockSegment'              = trans.stocksegment",
              "    ,'SpecialStockIndicator'     = trans.SPECIALSTOCKINDICATOR",
              "    ,'Plant'                     = trans.plant",
              "    ,'BatchID'                   = trans.BatchID",
              "    ,'Price'                     = trans.price",
              "    ,'Material'                  = trans.material",
              "    ,'Value'                     = trans.[value]",
              "    ,'GrossValue'                = GROSS",
              "    ,'FirstAssortmentSemester'   = cast(Left(ISNULL(nart.FirstAssortment, ''),5) as int)",
              "    ,'LatestAssortmentSemester'  = cast(left(ISNULL(nart.LatestAssortment, ''),5) as int)",
              "    ,'SourceSystem'              = 'EBP'",
              "FROM [sourcing].[InventoriesHistory] trans with(nolock)",
              "left join ref.NatArticles nart on nart.[NatArticle_BK] = trans.[NatArticle_BK]",
              "WHERE trans.[PostingDate] >= DATEFROMPARTS( YEAR(GETDATE())-2,01,01)  ",
              "  AND trans.[PostingDate] < '20260701' /* <-- FIXED HERE */",
              "  AND trans.plant <> 'IT90'",
              "  AND trans.CompanyCode in ('PT10','ES10','IT10')",
              "  AND stocksegment not in ('FPC')",
              "",
              "/* Crossbookings */",
              "",
              "union all",
              "",
              "SELECT ",
              "     'BookingDate'               = DATEFROMPARTS(2026,07,01)",
              "    ,'ArticleNumber_BK'          = trans.ArticleNumber_BK",
              "    ,'NatArticle_BK'             = trans.[NatArticle_BK]",
              "    ,'ArticleSize_BK'            = trans.[ArticleSize_BK]",
              "    ,'StyleNumber_BK'            = trans.[StyleNumber_BK]",
              "    ,'PDUCode'                   = trans.[PDUCode]",
              "    ,'CompanyCode'               = trans.COMPANYCODE",
              "    ,'PupMasterId'               = trans.[IntPupMasterId]",
              "    ,'ProdDivCode'               = trans.[ProdDivCode]",
              "    ,'RBUCode'                   = trans.[RBUCode]",
              "    ,'BrandCode'                 = trans.[BrandCode]",
              "    ,'CurrencyCode'              = trans.[PRICECURRENCY]",
              "    ,'NatStoreDC_BK'             = CASE WHEN LEN(trans.[NatStoreDC_BK]) >= 4 THEN LEFT(trans.[NatStoreDC_BK], LEN(trans.[NatStoreDC_BK]) - 4) + 'EU' ELSE trans.[NatStoreDC_BK] END",
              "    ,'InventoryTypeCode'         = trans.[IntInventoryTypeCode]",
              "    ,'InventoryStatusCode'       = trans.IntInventoryStatusCode",
              "    ,'InventoryType'             = trans.QTYTYPE",
              "    ,'IntAgeingCode'             = trans.[IntAgeingCode]",
              "    ,'BusinessTypeCode'          = BusinessTypeCode",
              "    ,'InventoryUnits'            = sum(trans.[Qty]) * -1",
              "    ,'StorageLocation'           = STORAGELOCATION",
              "    ,'StockSegment'              = trans.stocksegment",
              "    ,'SpecialStockIndicator'     = trans.SPECIALSTOCKINDICATOR",
              "    ,'Plant'                     = trans.plant",
              "    ,'BatchID'                   = trans.BatchID",
              "    ,'Price'                     = trans.price",
              "    ,'Material'                  = trans.material",
              "    ,'Value'                     = sum(trans.[value]) * -1",
              "    ,'GrossValue'                = sum(GROSS) * -1",
              "    ,'FirstAssortmentSemester'   = cast(Left(ISNULL(nart.FirstAssortment, ''),5) as int)",
              "    ,'LatestAssortmentSemester'  = cast(left(ISNULL(nart.LatestAssortment, ''),5) as int)",
              "    ,'SourceSystem'              = 'EBP'",
              "FROM [sourcing].[InventoriesHistory] trans with(nolock)",
              "left join ref.NatArticles nart on nart.[NatArticle_BK] = trans.[NatArticle_BK]",
              "WHERE trans.[PostingDate] < '20260701' /* <-- FIXED HERE */",
              "  AND trans.plant <> 'IT90'",
              "  AND trans.CompanyCode in ('PT10','ES10','IT10')",
              "  AND stocksegment not in ('FPC')",
              "GROUP BY",
              "     trans.ArticleNumber_BK",
              "    ,trans.[NatArticle_BK]",
              "    ,trans.[ArticleSize_BK]",
              "    ,trans.[StyleNumber_BK]",
              "    ,trans.[PDUCode]",
              "    ,trans.COMPANYCODE",
              "    ,trans.[IntPupMasterId]",
              "    ,trans.[ProdDivCode]",
              "    ,trans.[RBUCode]",
              "    ,trans.[BrandCode]",
              "    ,trans.[PRICECURRENCY]",
              "    ,trans.[NatStoreDC_BK]",
              "    ,trans.[IntInventoryTypeCode]",
              "    ,trans.IntInventoryStatusCode",
              "    ,trans.QTYTYPE",
              "    ,trans.[IntAgeingCode]",
              "    ,BusinessTypeCode",
              "    ,STORAGELOCATION",
              "    ,trans.stocksegment",
              "    ,trans.SPECIALSTOCKINDICATOR",
              "    ,trans.plant",
              "    ,trans.BatchID",
              "    ,trans.price",
              "    ,trans.material",
              "    ,nart.FirstAssortment",
              "    ,nart.LatestAssortment",
              "HAVING SUM(trans.[Qty]) <> 0  ",
              "   \",",
              "",
              "connAS_SE = Sql.Database(Param_Server_Europe_SP,Param_Database_SE_SP),",
              "",
              "Source = Value.NativeQuery(connAS_SE, query)",
              "in",
              "    Source"
            ]
          }
        }
      ],
      "annotations": [
        {
          "name": "#Marketing_Hidden"
        }
      ]
    }
  }
}