          "lineageTag": "56a37cb3-f390-4483-a01a-0766a124f01b"
        },
        {
          "name": "InventoryStatusCode",
          "dataType": "int64",
          "isHidden": true,
          "sourceColumn": "InventoryStatusCode",
          "isAvailableInMdx": false,
