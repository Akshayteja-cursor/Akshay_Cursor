          "dataType": "string",
          "isDataTypeInferred": true,
          "expression": "RELATED('dim_InventoryStatus'[InventoryStatusDesc] )"
        },
        {
          "name": "NatArticle_BK",
          "dataType": "string",
          "isHidden": true,
          "sourceColumn": "NatArticle_BK",
          "displayFolder": "References"
        },
        {
          "type": "calculated",
          "name": "SalesZoneCode",
          "dataType": "int64",
          "isDataTypeInferred": true,
          "isHidden": true,
          "expression": "IF(related('dim_StoreDC_Active'[IsTempStoreFlag]) =1 , 2, 1)",
          "displayFolder": "References",
          "summarizeBy": "none"
        },
        {
          "name": "ArticleNumber_BK",
