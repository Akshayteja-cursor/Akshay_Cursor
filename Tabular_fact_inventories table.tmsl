          "name": "RBUCode_c",
          "dataType": "int64",
          "isDataTypeInferred": true,
          "isHidden": true,
          "expression": "RELATED('dim_Style_Active'[RBUCode])",
          "isAvailableInMdx": false,
          "displayFolder": "References",
          "summarizeBy": "none"
        },
        {
          "type": "calculated",
          "name": "BusinessSegmentCode_c",
          "dataType": "int64",
          "isDataTypeInferred": true,
          "isHidden": true,
          "expression": "RELATED('dim_Style_Active'[BusinessSegmentCode])",
          "isAvailableInMdx": false,
          "displayFolder": "References",
          "summarizeBy": "none"
        },
        {
          "name": "RRP excl. VAT",
          "dataType": "double",
          "sourceColumn": "RRP_excl_VAT",
          "displayFolder": "Measures",
          "lineageTag": "440e69f5-d0c2-47b7-953c-fecc94e680b7"
        },
        {
          "name": "RRP incl. VAT",
          "dataType": "double",
          "sourceColumn": "RRP_incl_VAT",
          "displayFolder": "Measures",
          "lineageTag": "2696fb04-0b5e-4992-a2a2-86fbcb35d236"
        },
        {
          "name": "Inventory Stock Type",
          "dataType": "string",
          "sourceColumn": "InventoryStockType",
